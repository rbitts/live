+// Byte-level tokenizers may emit a partial UTF-8 scalar. Permit an unfinished
+// suffix, but never a token that makes the accumulated byte stream invalid.
+static bool validUtf8Prefix(const std::string& text, bool allowIncomplete) {
+    for (size_t i=0; i<text.size();) {
+        unsigned char a=text[i++]; if(a<0x80) continue;
+        int count=a>=0xC2 && a<=0xDF?1:a>=0xE0 && a<=0xEF?2:a>=0xF0 && a<=0xF4?3:-1;
+        if(count<0) return false;
+        for(int j=0;j<count;++j) {
+            if(i==text.size()) return allowIncomplete;
+            unsigned char b=text[i++];
+            if(b<0x80 || b>0xBF) return false;
+            if(j==0 && ((a==0xE0 && b<0xA0)||(a==0xED && b>=0xA0)||(a==0xF0 && b<0x90)||(a==0xF4 && b>=0x90))) return false;
+        }
+    }
+    return true;
+}
