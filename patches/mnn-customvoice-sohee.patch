+            bool stop=is_stop(token_id);
+            if(validUtf8Prefix(mContext->generate_str + (stop?"":tokenizer_decode(token_id)), !stop)) return token_id;
+            if(filtered.empty()) {
+                const float* values=logits->readMap<float>();
+                if(!values) return -1;
+                filtered.assign(values,values+logits->getInfo()->dim.back());
+            }
+            if(token_id>=static_cast<int>(filtered.size())) return -1;
+            filtered[token_id]=-std::numeric_limits<float>::infinity();
+            auto constrained=_Const(filtered.data(),{static_cast<int>(filtered.size())},NHWC,halide_type_of<float>());
+            token_id=mSampler->sample(constrained);
+        }
+        return -1;
+    }
     return token_id;
 }
 
